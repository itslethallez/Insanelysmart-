# Any standard Postgres connection string works (Neon, Supabase, etc.) via pg/Drizzle.
# If your DB host is IPv6-only (e.g. Supabase's direct host), use its connection
# pooler URL instead so IPv4-only networks can reach it.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# Twilio (outbound SMS proposals/confirmations). Leave unset and use DRY_RUN below to test
# without a Twilio account or credit.
TWILIO_ACCOUNT_SID=ACyour-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_FROM_NUMBER=+15555550100

# Set to true to log outbound SMS instead of sending them via Twilio.
DRY_RUN=true
