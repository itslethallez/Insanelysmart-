# Any standard Postgres connection string works (Supabase, etc.) via pg/Drizzle.
# Our database is Supabase. DATABASE_URL below is the transaction pooler (port 6543) —
# correct for the running app, but pgbouncer's transaction mode doesn't support the
# session-level features DDL needs, so it's the wrong one for migrations. See
# MIGRATION_DATABASE_URL below for that.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require

# Used only by drizzle-kit (generate/push/migrate), never by the running app. Same host and
# credentials as DATABASE_URL above, but the session pooler on port 5432 instead of the
# transaction pooler on 6543 — session pooler supports the session-level features DDL
# needs. Get the exact string from Supabase dashboard > Project Settings > Database >
# Connection string > "Session pooler" if this doesn't work.
#
# uselibpqcompat=true is there on purpose: newer pg-connection-string versions treat
# sslmode=require as strict full certificate-chain verification, which fails locally with
# "self-signed certificate in certificate chain" on some machines (antivirus/EDR doing SSL
# inspection is a common cause). uselibpqcompat=true restores the traditional
# encrypt-but-don't-verify behavior sslmode=require has always meant for Postgres tools.
MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# Which SMS provider handles /sms - "twilio" or "clicksend". Defaults to twilio when unset,
# so leaving this out changes nothing. Both providers implement the same interface
# (src/services/sms/types.ts); only this variable decides which one is active.
SMS_PROVIDER=twilio

# Twilio (outbound SMS proposals/confirmations). Leave unset and use DRY_RUN below to test
# without a Twilio account or credit.
TWILIO_ACCOUNT_SID=ACyour-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_FROM_NUMBER=+15555550100

# ClickSend (only used when SMS_PROVIDER=clicksend). API username and API key from
# ClickSend dashboard > API Credentials - not your ClickSend login password.
CLICKSEND_USERNAME=your-clicksend-username
CLICKSEND_API_KEY=your-clicksend-api-key
# Your ClickSend sender number/ID. May not be required if your account uses a shared number -
# confirm against your own ClickSend account setup before relying on this either way.
CLICKSEND_FROM_NUMBER=+61400000000

# Set to true to log outbound SMS instead of sending them via the active provider.
DRY_RUN=true
